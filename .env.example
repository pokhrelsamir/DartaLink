# Copy to .env and edit.  Never commit .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# postgres (default) or sqlite (quick local demo / tests)
DB_ENGINE=postgres
DB_NAME=dartalink_nepaltelecom
DB_USER=postgres
DB_PASSWORD=pass
DB_HOST=127.0.0.1
DB_PORT=5432
# Logo file inside static/ (replace with the official PNG/SVG if you have it)
BRAND_LOGO=img/nt-logo.png
# Password given to demo users by `manage.py seed_demo`
DEMO_PASSWORD=DartaLink@2026
MAX_UPLOAD_MB=10
# Workflow email notifications
WORKFLOW_NOTIFICATION_EMAIL=poksamir@gmail.com
# Comma-separated copy recipients and ROLE=email workflow routing.
WORKFLOW_CC_EMAILS=poksamir@gmail.com
WORKFLOW_ROLE_EMAILS=
# Keep all activity email in the shared inbox until employee email addresses are verified.
# Set to true later to deliver direct messages to each employee's User.email.
USE_EMPLOYEE_EMAILS=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=DartaLink <noreply@dartalink.example>
EMAIL_LOGO_PATH=Mail-Logo.svg
